# =============================================================================
# Polygon Migration Tool - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Django Settings
# -----------------------------------------------------------------------------

# Generate a new secret key for production:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here-generate-a-new-one

# Set to True for development, False for production
DEBUG=True

# Comma-separated list of allowed hosts
# For local development: localhost,127.0.0.1
# For production: your-domain.com
ALLOWED_HOSTS=localhost,127.0.0.1

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
#
# Local setup with Docker:
#   docker run --name polygon-postgres -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=polygon_migration -p 5432:5432 -d postgres:15
#
# Then use these settings:
DB_NAME=polygon_migration
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# -----------------------------------------------------------------------------
# Redis Cache
# -----------------------------------------------------------------------------
#
# Local setup with Docker:
#   docker run --name polygon-redis -p 6379:6379 -d redis:7
#
# Then use these settings:
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=False

# For Azure Redis or other cloud Redis with SSL:
# REDIS_HOST=your-redis.redis.cache.windows.net
# REDIS_PORT=6380
# REDIS_PASSWORD=your-redis-password
# REDIS_SSL=True

# -----------------------------------------------------------------------------
# Polygon API Credentials
# -----------------------------------------------------------------------------
#
# Get your API credentials from Polygon:
# 1. Log in to https://polygon.codeforces.com/
# 2. Go to Settings (top-right menu)
# 3. Find "API" section
# 4. Generate new API key
#
POLYGON_API_KEY=your-polygon-api-key
POLYGON_API_SECRET=your-polygon-api-secret

# -----------------------------------------------------------------------------
# Cloud Storage Configuration
# -----------------------------------------------------------------------------
#
# Test cases are uploaded through a provider-agnostic interface
# (problems/storage/). Pick the backend with STORAGE_PROVIDER below and fill
# in that provider's variables. Implemented providers: s3, azure.
#
# Files are written as:
#   test_cases/{db_problem_id}/{NN}      test input  (NN = 01, 02, ...)
#   test_cases/{db_problem_id}/{NN}.a    expected output
#

# Which storage provider to use. Options: s3, azure
STORAGE_PROVIDER=s3

# --- AWS S3 (STORAGE_PROVIDER=s3) ---
# The IAM user/role needs s3:PutObject, s3:ListBucket and s3:DeleteObject on the bucket.
# AWS_REGION must be the bucket's region.
# If AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY are left empty, boto3's default
# credential chain is used (IAM role, ~/.aws/credentials, AWS_PROFILE, ...).
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=your-bucket-name

# --- Azure Blob Storage (STORAGE_PROVIDER=azure) ---
# AZURE_STORAGE_ACCOUNT_URL=https://youraccount.blob.core.windows.net
# AZURE_TENANT_ID=your-tenant-id
# AZURE_CLIENT_ID=your-client-id
# AZURE_USERNAME=your-azure-username
# AZURE_PASSWORD=your-azure-password
# AZURE_CONTAINER_NAME=testcases

# --- Not implemented yet: add a TestCaseStorage subclass in problems/storage/
# --- and register it in problems/storage/__init__.py to support these. ---

# --- Google Cloud Storage ---
# GCS_PROJECT_ID=your-project-id
# GCS_BUCKET_NAME=your-bucket-name
# GCS_CREDENTIALS_FILE=/path/to/service-account.json

# --- Google Drive ---
# GOOGLE_DRIVE_CREDENTIALS_FILE=/path/to/credentials.json
# GOOGLE_DRIVE_FOLDER_ID=your-folder-id

# --- Cloudflare R2 ---
# R2_ACCOUNT_ID=your-account-id
# R2_ACCESS_KEY_ID=your-access-key
# R2_SECRET_ACCESS_KEY=your-secret-key
# R2_BUCKET_NAME=your-bucket-name

# --- MinIO ---
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET_NAME=testcases
# MINIO_SECURE=False

# -----------------------------------------------------------------------------
# Custom Checker Compilation
# -----------------------------------------------------------------------------
#
# Directory for compiling custom checkers (optional)
# If not set, uses system temp directory
# Requires g++ compiler installed on your system
#
# CUSTOM_CHECKER_DIR=/path/to/checker/directory

# -----------------------------------------------------------------------------
# Quick Start Commands
# -----------------------------------------------------------------------------
#
# 1. Start PostgreSQL and Redis:
#    docker run --name polygon-postgres -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=polygon_migration -p 5432:5432 -d postgres:15
#    docker run --name polygon-redis -p 6379:6379 -d redis:7
#
# 2. Apply migrations:
#    python manage.py migrate
#
# 3. Create superuser:
#    python manage.py createsuperuser
#
# 4. Run server:
#    python manage.py runserver
#
# 5. Access app:
#    http://localhost:8000/
#
